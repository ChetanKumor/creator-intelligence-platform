{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestType": {
      "type": "string",
      "const": "ReferenceBoundaryBenchmark"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "benchmarkId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "toleranceFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "cases": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "creatorGroupId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600
          },
          "fps": {
            "type": "object",
            "properties": {
              "numerator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 120000
              },
              "denominator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 1001
              }
            },
            "required": [
              "numerator",
              "denominator"
            ],
            "additionalProperties": false
          },
          "labelSource": {
            "type": "string",
            "enum": [
              "synthetic_generated",
              "manually_reviewed"
            ]
          },
          "annotatorId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "boundariesSeconds": {
            "maxItems": 999,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "required": [
          "contentHash",
          "creatorGroupId",
          "durationSeconds",
          "fps",
          "labelSource",
          "annotatorId",
          "boundariesSeconds"
        ],
        "additionalProperties": false
      }
    },
    "casesDigest": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "manifestType",
    "schemaVersion",
    "benchmarkId",
    "version",
    "frozenAt",
    "toleranceFrames",
    "cases",
    "casesDigest"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:interchange:ReferenceBoundaryBenchmark:1.0.0",
  "$comment": "Generated from TypeScript-owned schemas. TypeScript semantic validation remains mandatory."
}
