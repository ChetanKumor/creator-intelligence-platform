              "frameIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "sampleId",
              "shotId",
              "frameIndex",
              "atSeconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocolVersion",
        "operation",
        "mediaPath",
        "ffmpegPath",
        "frameRoot",
        "samples"
