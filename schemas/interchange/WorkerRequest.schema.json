            "device": {
              "type": "string",
              "enum": [
                "cpu",
                "cuda"
              ]
            },
            "cpuFallback": {
              "type": "boolean"
            },
            "maxPatches": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 256
                },
                {
                  "type": "number",
                  "const": 512
                },
                {
                  "type": "number",
                  "const": 1024
