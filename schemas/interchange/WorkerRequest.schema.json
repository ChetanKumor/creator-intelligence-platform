        "sampleIds": {
          "minItems": 1,
          "maxItems": 3000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "protocolVersion",
        "operation",
        "frameRoot",
        "modelRoot",
        "config",
        "sampleIds"
      ],
      "additionalProperties": false
