          "type": "string",
          "const": "1.0.0"
        },
        "operation": {
          "type": "string",
          "const": "sample"
        },
        "mediaPath": {
          "type": "string",
          "minLength": 1
        },
        "ffmpegPath": {
          "type": "string",
          "minLength": 1
