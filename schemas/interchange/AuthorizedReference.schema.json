{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestType": {
      "type": "string",
      "const": "AuthorizedReference"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "synthetic",
        "owner_supplied"
      ]
    },
    "authorizationBasis": {
      "type": "string",
      "enum": [
        "synthetic_generated",
        "owner_created",
        "permission_granted"
      ]
    },
    "allowedPurposes": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local_reference_analysis",
          "local_evaluation"
        ]
      }
    },
    "dateAdded": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "creatorId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "manifestType",
    "schemaVersion",
    "contentHash",
    "sizeBytes",
    "sourceType",
    "authorizationBasis",
    "allowedPurposes",
    "dateAdded",
    "creatorId",
    "projectId"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:interchange:AuthorizedReference:1.0.0",
  "$comment": "Generated from TypeScript-owned schemas. TypeScript semantic validation remains mandatory."
}
