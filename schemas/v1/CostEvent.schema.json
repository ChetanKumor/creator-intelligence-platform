{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "CostEvent"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "creatorId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "synthetic",
            "production"
          ]
        }
      },
      "required": [
        "projectId",
        "jobId",
        "creatorId",
        "environment"
      ],
      "additionalProperties": false
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "tool": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelRunId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "reference_analysis",
        "footage_analysis",
        "audio_analysis",
        "embedding",
        "speech",
        "matching",
        "planning",
        "rendering",
        "qc",
        "storage"
      ]
    },
    "durationMilliseconds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "units": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "enum": [
              "input_tokens",
              "output_tokens",
              "frames",
              "audio_seconds",
              "video_seconds",
              "cpu_seconds",
              "gpu_seconds",
              "bytes",
              "operations"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "unit",
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "costInrMicros": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "costSource": {
      "type": "string",
      "enum": [
        "measured",
        "estimated",
        "synthetic"
      ]
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "eventId",
    "scope",
    "occurredAt",
    "operationId",
    "attempt",
    "provider",
    "tool",
    "model",
    "modelRunId",
    "operation",
    "durationMilliseconds",
    "units",
    "costInrMicros",
    "costSource"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:CostEvent:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
