{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "ModelRun"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "creatorId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "synthetic",
            "production"
          ]
        }
      },
      "required": [
        "projectId",
        "jobId",
        "creatorId",
        "environment"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "operation": {
      "type": "string",
      "enum": [
        "reference_analysis",
        "footage_analysis",
        "audio_analysis",
        "embedding",
        "speech",
        "matching",
        "planning",
        "rendering",
        "qc",
        "storage"
      ]
    },
    "inputIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "outputIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "runId",
    "scope",
    "provider",
    "model",
    "modelVersion",
    "adapterVersion",
    "operation",
    "inputIds",
    "outputIds",
    "startedAt",
    "endedAt",
    "status",
    "errorCode"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:ModelRun:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
