{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "AudioFingerprint"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "fingerprintId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "bpm": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 20,
          "maximum": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "beatsSeconds": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "downbeatsSeconds": {
      "maxItems": 15000,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "energy": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atSeconds": {
            "type": "number",
            "minimum": 0
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "atSeconds",
          "energy"
        ],
        "additionalProperties": false
      }
    },
    "mainDropSeconds": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "phraseBoundariesSeconds": {
      "maxItems": 15000,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "speechRegions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "startSeconds",
          "endSeconds"
        ],
        "additionalProperties": false
      }
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "modelRunIds": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        }
      },
      "required": [
        "producer",
        "producerVersion",
        "modelRunIds",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "fingerprintId",
    "assetId",
    "durationSeconds",
    "bpm",
    "beatsSeconds",
    "downbeatsSeconds",
    "energy",
    "mainDropSeconds",
    "phraseBoundariesSeconds",
    "speechRegions",
    "language",
    "provenance"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:AudioFingerprint:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
