{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "JobState"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "UPLOADED",
        "ANALYZING_REFERENCE",
        "ANALYZING_FOOTAGE",
        "ANALYZING_AUDIO",
        "MATCHING",
        "PLANNING",
        "RENDERING_PREVIEW",
        "QC",
        "PREVIEW_READY",
        "REVISION_REQUESTED",
        "RENDERING_FINAL",
        "COMPLETE",
        "FAILED"
      ]
    },
    "stateVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activePlanId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeRenderId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeRenderKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dry_run",
            "media"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "renderIntent": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "preview",
            "final"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "enum": [
                "UPLOADED",
                "ANALYZING_REFERENCE",
                "ANALYZING_FOOTAGE",
                "ANALYZING_AUDIO",
                "MATCHING",
                "PLANNING",
                "RENDERING_PREVIEW",
                "QC",
                "RENDERING_FINAL"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "retryable": {
              "type": "boolean"
            },
            "failedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "stage",
            "code",
            "message",
            "retryable",
            "failedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "jobId",
    "projectId",
    "state",
    "stateVersion",
    "attempt",
    "revision",
    "activePlanId",
    "activeRenderId",
    "activeRenderKind",
    "renderIntent",
    "failure",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:JobState:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
