{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "DecisionEvent"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "creatorId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "synthetic",
            "production"
          ]
        }
      },
      "required": [
        "projectId",
        "jobId",
        "creatorId",
        "environment"
      ],
      "additionalProperties": false
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "decisionKind": {
      "type": "string",
      "enum": [
        "clip_selection",
        "transition_selection",
        "speed_selection",
        "trim_selection",
        "caption_selection"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "slotId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "referenceFingerprintId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioFingerprintId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "creatorMemoryRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "featureSetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "features": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "numeric"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "category"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "planId",
        "revision",
        "slotId",
        "referenceFingerprintId",
        "audioFingerprintId",
        "creatorMemoryRevision",
        "featureSetVersion",
        "features"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "clip_segment"
                  },
                  "segmentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "kind",
                  "segmentId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "transition"
                  },
                  "transition": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "cut"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "dissolve"
                          },
                          "durationSeconds": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 2
                          }
                        },
                        "required": [
                          "type",
                          "durationSeconds"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "transition"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "speed"
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 4
                  }
                },
                "required": [
                  "kind",
                  "speed"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "trim"
                  },
                  "segmentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "sourceRange": {
                    "type": "object",
                    "properties": {
                      "startSeconds": {
                        "type": "number",
                        "minimum": 0
                      },
                      "endSeconds": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "startSeconds",
                      "endSeconds"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "segmentId",
                  "sourceRange"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "caption"
                  },
                  "captionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "contentRevisionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "clean",
                      "emphasis"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "captionId",
                  "contentRevisionId",
                  "language",
                  "style"
                ],
                "additionalProperties": false
              }
            ]
          },
          "features": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "numeric"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "category"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "boolean"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                    },
                    "value": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "candidateId",
          "value",
          "features",
          "score"
        ],
        "additionalProperties": false
      }
    },
    "winnerCandidateId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "rule",
            "model",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "modelRunIds": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
      }
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "eventId",
    "scope",
    "occurredAt",
    "decisionId",
    "decisionKind",
    "context",
    "candidates",
    "winnerCandidateId",
    "confidence",
    "policy",
    "modelRunIds"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:DecisionEvent:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
