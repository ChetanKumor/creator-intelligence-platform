{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "UniversalEditPlan"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parentPlanId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "aspectRatio": {
          "type": "string",
          "const": "9:16"
        },
        "resolution": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "fps": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 120000
            },
            "denominator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1001
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "targetDurationSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 30
        }
      },
      "required": [
        "aspectRatio",
        "resolution",
        "fps",
        "targetDurationSeconds"
      ],
      "additionalProperties": false
    },
    "clips": {
      "minItems": 1,
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clipId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "segmentId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "sourceRange": {
            "type": "object",
            "properties": {
              "startSeconds": {
                "type": "number",
                "minimum": 0
              },
              "endSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startSeconds",
              "endSeconds"
            ],
            "additionalProperties": false
          },
          "outputStartSeconds": {
            "type": "number",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "enum": [
              "hook",
              "setup",
              "build",
              "reveal",
              "hero",
              "outro",
              "supporting"
            ]
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4
          },
          "transform": {
            "type": "object",
            "properties": {
              "fit": {
                "type": "string",
                "enum": [
                  "cover",
                  "contain"
                ]
              },
              "focalPoint": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "scale": {
                "type": "number",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "fit",
              "focalPoint",
              "scale"
            ],
            "additionalProperties": false
          },
          "sourceAudioGain": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "transitionOut": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "cut"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "dissolve"
                  },
                  "durationSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  }
                },
                "required": [
                  "type",
                  "durationSeconds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decisionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "required": [
          "clipId",
          "segmentId",
          "assetId",
          "sourceRange",
          "outputStartSeconds",
          "role",
          "speed",
          "transform",
          "sourceAudioGain",
          "transitionOut",
          "reason",
          "confidence",
          "decisionId"
        ],
        "additionalProperties": false
      }
    },
    "music": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "audioFingerprintId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "sourceRange": {
              "type": "object",
              "properties": {
                "startSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "endSeconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "startSeconds",
                "endSeconds"
              ],
              "additionalProperties": false
            },
            "outputStartSeconds": {
              "type": "number",
              "minimum": 0
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "fadeInSeconds": {
              "type": "number",
              "minimum": 0
            },
            "fadeOutSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "assetId",
            "audioFingerprintId",
            "sourceRange",
            "outputStartSeconds",
            "gain",
            "fadeInSeconds",
            "fadeOutSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "captions": {
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "captionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "range": {
            "type": "object",
            "properties": {
              "startSeconds": {
                "type": "number",
                "minimum": 0
              },
              "endSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startSeconds",
              "endSeconds"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "position": {
            "type": "string",
            "enum": [
              "upper",
              "middle",
              "lower"
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "clean",
              "emphasis"
            ]
          }
        },
        "required": [
          "captionId",
          "range",
          "text",
          "language",
          "position",
          "style"
        ],
        "additionalProperties": false
      }
    },
    "overlays": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "overlayId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
              },
              "range": {
                "type": "object",
                "properties": {
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "startSeconds",
                  "endSeconds"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "position": {
                "type": "string",
                "enum": [
                  "upper",
                  "middle",
                  "lower"
                ]
              }
            },
            "required": [
              "type",
              "overlayId",
              "range",
              "text",
              "position"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "effects": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "color_preset"
              },
              "effectId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
              },
              "range": {
                "type": "object",
                "properties": {
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "startSeconds",
                  "endSeconds"
                ],
                "additionalProperties": false
              },
              "preset": {
                "type": "string",
                "enum": [
                  "neutral",
                  "warm",
                  "cool"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "type",
              "effectId",
              "range",
              "preset",
              "intensity"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "planner": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "plannerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "modelRunIds": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "referenceFingerprintId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        }
      },
      "required": [
        "planner",
        "plannerVersion",
        "modelRunIds",
        "referenceFingerprintId",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "planId",
    "projectId",
    "revision",
    "parentPlanId",
    "output",
    "clips",
    "music",
    "captions",
    "overlays",
    "effects",
    "metadata"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:UniversalEditPlan:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
