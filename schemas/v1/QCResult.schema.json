{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "QCResult"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "qcId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "renderId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "plan_only",
        "media"
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "deliveryAllowed": {
      "type": "boolean"
    },
    "checks": {
      "minItems": 10,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "plan_digest",
              "timeline_duration",
              "non_zero_file",
              "duration",
              "frame_count",
              "codec",
              "resolution",
              "audio_present",
              "black_frames",
              "av_sync"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "expected": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "seconds"
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "milliseconds"
                      },
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "count"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "bytes"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "boolean"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "codec"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "h264",
                          "hevc",
                          "av1",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "resolution"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "width": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 16384
                          },
                          "height": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 16384
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "frame_rate"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 120000
                          },
                          "denominator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1001
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "seconds"
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "milliseconds"
                      },
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "count"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "bytes"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "boolean"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "codec"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "h264",
                          "hevc",
                          "av1",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "resolution"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "width": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 16384
                          },
                          "height": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 16384
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "const": "frame_rate"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 120000
                          },
                          "denominator": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 1001
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "required": [
          "name",
          "status",
          "expected",
          "observed",
          "reasonCode"
        ],
        "additionalProperties": false
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "qcId",
    "renderId",
    "projectId",
    "jobId",
    "planId",
    "planRevision",
    "mode",
    "policyVersion",
    "outcome",
    "deliveryAllowed",
    "checks",
    "checkedAt"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:QCResult:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
