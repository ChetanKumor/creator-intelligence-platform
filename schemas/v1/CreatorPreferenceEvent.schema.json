{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractType": {
      "type": "string",
      "const": "CreatorPreferenceEvent"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "creatorId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "synthetic",
            "production"
          ]
        }
      },
      "required": [
        "projectId",
        "jobId",
        "creatorId",
        "environment"
      ],
      "additionalProperties": false
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "preferenceId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "basisFeedbackEventIds": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "signal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pairwise_clip"
            },
            "preferredSegmentId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "disfavoredSegmentId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "contextDecisionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "preferredSegmentId",
            "disfavoredSegmentId",
            "contextDecisionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "transition_affinity"
            },
            "transition": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "cut"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "dissolve"
                    },
                    "durationSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "type",
                    "durationSeconds"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "direction": {
              "type": "string",
              "enum": [
                "positive",
                "negative"
              ]
            }
          },
          "required": [
            "kind",
            "transition",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "caption_language"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            }
          },
          "required": [
            "kind",
            "language"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pacing"
            },
            "preference": {
              "type": "string",
              "enum": [
                "faster",
                "slower"
              ]
            }
          },
          "required": [
            "kind",
            "preference"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidenceStrength": {
      "type": "string",
      "enum": [
        "explicit_correction",
        "implicit_outcome"
      ]
    },
    "derivationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "contractType",
    "schemaVersion",
    "eventId",
    "scope",
    "occurredAt",
    "preferenceId",
    "basisFeedbackEventIds",
    "signal",
    "evidenceStrength",
    "derivationVersion"
  ],
  "additionalProperties": false,
  "$id": "urn:creator-intelligence:CreatorPreferenceEvent:1.0.0",
  "$comment": "Structural interchange schema. Cross-field and cross-asset checks in packages/contracts and packages/validation are also mandatory."
}
